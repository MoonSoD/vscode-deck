{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Extension",
      "type": "extensionHost",
      "request": "launch",
      "args": ["--extensionDevelopmentPath=${workspaceFolder}"],
      "outFiles": ["${workspaceFolder}/dist/**/*.js"],
      "preLaunchTask": "npm: build"
    },
    // QA: "fresh machine" for the hook install/upgrade flow (QA doc §1). Claude
    // stays detectable (real PATH), but Deck's config reads/writes land in
    // scratch dirs and globalState starts empty (no dismissed flag, no repo
    // registry), so the setup offer fires like a first install.
    //
    // One-time setup (re-run after a reboot — /tmp is ephemeral):
    //   mkdir -p /tmp/deck-qa/fresh-claude /tmp/deck-qa/fresh-codex /tmp/deck-qa/fresh-data
    // Factory-reset between runs:
    //   rm -rf /tmp/deck-qa/fresh-user-data /tmp/deck-qa/fresh-data
    //   rm -rf /tmp/deck-qa/fresh-claude /tmp/deck-qa/fresh-codex && mkdir -p /tmp/deck-qa/fresh-claude /tmp/deck-qa/fresh-codex
    //
    // Legacy-upgrade test: accept the fresh install, then prune the scratch
    // settings down to the v0.5 events and reload the dev host:
    //   cd /tmp/deck-qa/fresh-claude && jq '.hooks |= with_entries(select(.key == "SessionStart" or .key == "UserPromptSubmit" or .key == "SessionEnd"))' settings.json > s.tmp && mv s.tmp settings.json
    //
    // ⚠️ Install-flow QA only (QA doc §1). Live-agent scenarios (§2+) belong in
    // the normal "Run Extension" profile: the deck tmux server is machine-global
    // and its panes don't inherit this profile's CLAUDE_CONFIG_DIR, so agents
    // launched in terminals here still use your real ~/.claude hooks.
    {
      "name": "Run Extension (fresh machine)",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}",
        "--user-data-dir=/tmp/deck-qa/fresh-user-data"
      ],
      "outFiles": ["${workspaceFolder}/dist/**/*.js"],
      "preLaunchTask": "npm: build",
      "env": {
        "CLAUDE_CONFIG_DIR": "/tmp/deck-qa/fresh-claude",
        // Own scratch dir, NOT none-codex: codex is detected via its PATH
        // binary, so the offer includes it and accepting writes hooks.json
        // here — reusing none-codex would create the dir the "no agents"
        // profile needs absent.
        "CODEX_HOME": "/tmp/deck-qa/fresh-codex",
        "XDG_DATA_HOME": "/tmp/deck-qa/fresh-data"
      }
    },
    // QA: verify "no agents detected -> no setup notification". Hides claude/codex
    // from agent detection while keeping tmux working (so the tmux-availability
    // gate still passes and the silence is really about agents).
    //
    // One-time setup (re-run after a reboot — /tmp is ephemeral):
    //   mkdir -p /tmp/deck-qa/bin
    //   ln -sf /opt/homebrew/bin/tmux /tmp/deck-qa/bin/tmux   # REAL binary, not the zsh `tmux` alias
    //   ln -sf /usr/bin/git           /tmp/deck-qa/bin/git
    //   rm -rf /tmp/deck-qa/none-claude /tmp/deck-qa/none-codex
    //
    // If tmux/claude/codex move, re-check with `which -a tmux claude codex` and adjust.
    // Run: pick this config in Run & Debug, F5. Expect no notification, and
    // "Deck: Install agent hooks" -> "No Claude or Codex installation detected."
    //
    // ⚠️ DO NOT run claude/codex in this profile. CLAUDE_CONFIG_DIR/CODEX_HOME are
    // redirected, so a real agent run would init a fresh config there (no creds ->
    // re-auth prompt) AND create the dir, which then breaks detection. This profile
    // is for the *detection* test only. If you slipped: `rm -rf /tmp/deck-qa/none-*`
    // and run agents from the normal "Run Extension" profile (your ~/.claude is fine).
    {
      "name": "Run Extension (no agents)",
      "type": "extensionHost",
      "request": "launch",
      "args": ["--extensionDevelopmentPath=${workspaceFolder}"],
      "outFiles": ["${workspaceFolder}/dist/**/*.js"],
      "preLaunchTask": "npm: build",
      "env": {
        // /tmp/deck-qa/bin holds ONLY tmux + git symlinks (codex lives in
        // /opt/homebrew/bin and claude in ~/.local/bin, so we can't just keep
        // those dirs). This PATH makes tmux resolvable but claude/codex not.
        "PATH": "/tmp/deck-qa/bin:/usr/bin:/bin",
        // Config-dir lookups point at paths that DON'T exist (don't create them).
        "CLAUDE_CONFIG_DIR": "/tmp/deck-qa/none-claude",
        "CODEX_HOME": "/tmp/deck-qa/none-codex"
      }
    }
  ]
}
