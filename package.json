{
  "name": "deck",
  "displayName": "Deck",
  "description": "Switch between git worktrees of multiple registered repositories from a single Activity Bar tree.",
  "version": "0.0.6",
  "publisher": "a9a4k",
  "repository": {
    "type": "git",
    "url": "https://github.com/a9a4k/vscode-deck.git"
  },
  "bugs": {
    "url": "https://github.com/a9a4k/vscode-deck/issues"
  },
  "homepage": "https://github.com/a9a4k/vscode-deck#readme",
  "license": "MIT",
  "icon": "icon.png",
  "keywords": [
    "git",
    "worktree",
    "worktrees",
    "projects",
    "monorepo"
  ],
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "SCM Providers",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "deck",
          "title": "Deck",
          "icon": "$(repo)"
        }
      ]
    },
    "views": {
      "deck": [
        {
          "id": "deck.projects",
          "name": "Projects & Worktrees"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "deck.projects",
        "contents": "No projects yet.\n[Add Project](command:deck.addProject)"
      }
    ],
    "commands": [
      {
        "command": "deck.addProject",
        "title": "Deck: Add Project",
        "icon": "$(add)"
      },
      {
        "command": "deck.addWorktree",
        "title": "Deck: Add Worktree",
        "icon": "$(add)"
      },
      {
        "command": "deck.removeWorktree",
        "title": "Deck: Delete Worktree…",
        "icon": "$(trash)"
      },
      {
        "command": "deck.removeProject",
        "title": "Deck: Remove from Deck…"
      },
      {
        "command": "deck.switchWorktree",
        "title": "Deck: Switch to Worktree"
      },
      {
        "command": "deck.refresh",
        "title": "Deck: Refresh",
        "icon": "$(refresh)"
      }
    ],
    "keybindings": [
      {
        "command": "workbench.view.extension.deck",
        "key": "ctrl+alt+d"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "deck.addProject",
          "when": "view == deck.projects",
          "group": "navigation"
        },
        {
          "command": "deck.refresh",
          "when": "view == deck.projects",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "deck.addWorktree",
          "when": "view == deck.projects && viewItem == deck.project",
          "group": "inline"
        },
        {
          "command": "deck.removeWorktree",
          "when": "view == deck.projects && viewItem == deck.worktree",
          "group": "inline"
        },
        {
          "command": "deck.removeWorktree",
          "when": "view == deck.projects && viewItem == deck.worktree",
          "group": "navigation"
        },
        {
          "command": "deck.removeProject",
          "when": "view == deck.projects && viewItem == deck.project",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Deck",
      "properties": {
        "deck.projects": {
          "type": "array",
          "default": [],
          "description": "Absolute paths to project root directories. Each is scanned for git worktrees.",
          "items": {
            "type": "string"
          }
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "tsc -p .",
    "test": "vitest run",
    "watch": "tsc -w -p .",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@ai-hero/sandcastle": "^0.5.12",
    "@types/node": "^20.x",
    "@types/vscode": "^1.95.0",
    "typescript": "^5.7.2",
    "vitest": "^4.1.8"
  }
}
