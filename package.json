{
  "name": "deck",
  "displayName": "Deck",
  "description": "Switch between git worktrees of multiple registered repositories from a single secondary sidebar tree.",
  "version": "0.1.8",
  "publisher": "a9a4k",
  "repository": {
    "type": "git",
    "url": "https://github.com/a9a4k/vscode-deck.git"
  },
  "bugs": {
    "url": "https://github.com/a9a4k/vscode-deck/issues"
  },
  "homepage": "https://github.com/a9a4k/vscode-deck#readme",
  "license": "MIT",
  "icon": "icon.png",
  "keywords": [
    "git",
    "worktree",
    "worktrees",
    "projects",
    "monorepo"
  ],
  "engines": {
    "vscode": "^1.106.0"
  },
  "categories": [
    "SCM Providers",
    "Other"
  ],
  "activationEvents": [
    "onView:deck.projects"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "secondarySidebar": [
        {
          "id": "deck",
          "title": "Deck",
          "icon": "$(folder)"
        }
      ]
    },
    "views": {
      "deck": [
        {
          "id": "deck.projects",
          "name": "Projects & Worktrees"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "deck.projects",
        "contents": "No projects yet.\n[Add Project](command:deck.addProject)"
      }
    ],
    "walkthroughs": [
      {
        "id": "deck.getStarted",
        "title": "Deck",
        "description": "Open Deck from the secondary sidebar.",
        "steps": [
          {
            "id": "deck.secondarySidebar",
            "title": "Deck lives in the secondary sidebar.",
            "description": "Open the secondary sidebar, then select Deck.",
            "media": {
              "markdown": "media/walkthroughs/secondary-sidebar.md"
            },
            "completionEvents": [
              "onCommand:workbench.action.toggleAuxiliaryBar"
            ]
          }
        ]
      }
    ],
    "customEditors": [
      {
        "viewType": "deck.terminal",
        "displayName": "Deck Terminal",
        "selector": [
          {
            "filenamePattern": "deck-terminal://**"
          }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "deck.addProject",
        "title": "Deck: Add Project",
        "icon": "$(add)"
      },
      {
        "command": "deck.addWorktree",
        "title": "Deck: Add Worktree",
        "icon": "$(add)"
      },
      {
        "command": "deck.removeWorktree",
        "title": "Deck: Delete Worktree…",
        "icon": "$(trash)"
      },
      {
        "command": "deck.removeProject",
        "title": "Deck: Remove from Deck…"
      },
      {
        "command": "deck.switchWorktree",
        "title": "Deck: Switch to Worktree"
      },
      {
        "command": "deck.openWorktreeInNewWindow",
        "title": "Deck: Open Worktree in New Window"
      },
      {
        "command": "deck.addTerminal",
        "title": "Deck: Add Terminal",
        "icon": "$(add)"
      },
      {
        "command": "deck.openTerminal",
        "title": "Deck: Open Terminal"
      },
      {
        "command": "deck.openTerminalInNewWindow",
        "title": "Deck: Open Terminal in New Window"
      },
      {
        "command": "deck.killTerminal",
        "title": "Deck: Close Terminal",
        "icon": "$(close)"
      },
      {
        "command": "deck.terminal.find",
        "title": "Deck Terminal: Find"
      },
      {
        "command": "deck.refresh",
        "title": "Deck: Refresh",
        "icon": "$(refresh)"
      }
    ],
    "keybindings": [
      {
        "command": "workbench.view.extension.deck",
        "key": "ctrl+alt+d"
      },
      {
        "command": "deck.terminal.find",
        "key": "ctrl+f",
        "mac": "cmd+f",
        "when": "activeCustomEditorId == 'deck.terminal'"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "deck.addProject",
          "when": "view == deck.projects",
          "group": "navigation"
        },
        {
          "command": "deck.refresh",
          "when": "view == deck.projects",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "deck.addWorktree",
          "when": "view == deck.projects && viewItem == deck.project",
          "group": "inline"
        },
        {
          "command": "deck.addTerminal",
          "when": "view == deck.projects && (viewItem == deck.worktree || viewItem == deck.worktree.active || viewItem == deck.worktree.main) && deck.tmuxAvailable",
          "group": "inline"
        },
        {
          "command": "deck.removeWorktree",
          "when": "view == deck.projects && viewItem == deck.worktree",
          "group": "navigation"
        },
        {
          "command": "deck.openWorktreeInNewWindow",
          "when": "view == deck.projects && (viewItem == deck.worktree || viewItem == deck.worktree.main)",
          "group": "navigation"
        },
        {
          "command": "deck.removeProject",
          "when": "view == deck.projects && viewItem == deck.project",
          "group": "navigation"
        },
        {
          "command": "deck.killTerminal",
          "when": "view == deck.projects && (viewItem == deck.terminal.active || viewItem == deck.terminal.foreign) && deck.tmuxAvailable",
          "group": "inline"
        },
        {
          "command": "deck.openTerminalInNewWindow",
          "when": "view == deck.projects && viewItem == deck.terminal.foreign && deck.tmuxAvailable",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "deck.openWorktreeInNewWindow",
          "when": "false"
        },
        {
          "command": "deck.killTerminal",
          "when": "false"
        },
        {
          "command": "deck.addTerminal",
          "when": "false"
        },
        {
          "command": "deck.openTerminal",
          "when": "false"
        },
        {
          "command": "deck.openTerminalInNewWindow",
          "when": "false"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "tsc -p .",
    "test": "vitest run",
    "watch": "tsc -w -p .",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@ai-hero/sandcastle": "^0.7.0",
    "@types/node": "^20.x",
    "@types/vscode": "^1.106.0",
    "typescript": "^5.7.2",
    "vitest": "^4.1.8"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0"
  }
}
